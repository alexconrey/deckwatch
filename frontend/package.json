{
  "name": "deckwatch-frontend",
  "private": true,
  "type": "module",
  "version": "0.6.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck:test": "vue-tsc -p tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vue/devtools-api": "^8.2.1",
    "chart.js": "^4.6.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-chartjs": "^5.3.7",
    "vue-router": "^4.6.5",
    "vuetify": "^4.3.3",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^2.2.12"
  }
}
