{
  "name": "deckwatch-frontend",
  "private": true,
  "type": "module",
  "version": "0.6.7",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck:test": "vue-tsc -p tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "chart.js": "^4.6.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.46",
    "vue-chartjs": "^5.3.7",
    "vue-router": "^4.6.5",
    "vuetify": "^3.13.8",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.7",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "typescript": "~5.7.3",
    "vite": "^6.4.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.12"
  }
}
